<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="바로메모"
        android:theme="@style/AppTheme">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="stateVisible|adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 위젯·알림을 누르면 뜨는 작은 입력창 -->
        <activity
            android:name=".QuickInputActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:theme="@style/QuickTheme"
            android:windowSoftInputMode="stateAlwaysVisible|adjustResize" />

        <!-- 다른 앱의 "공유"에서 바로메모를 고르면 바로 저장 -->
        <activity
            android:name=".ShareActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="바로메모에 저장"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
        </activity>

        <!-- 알림창 버튼에서 쓰는 화면 없는 도우미 (말로 쓰기, 사진·그림) -->
        <activity
            android:name=".CaptureActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:taskAffinity=""
            android:theme="@style/ClearTheme" />

        <!-- 간단한 그림 그리기 -->
        <activity
            android:name=".DrawActivity"
            android:exported="false" />

        <!-- 알림창에서 바로 입력한 내용을 저장 -->
        <receiver
            android:name=".NoteReplyReceiver"
            android:exported="false" />

        <!-- 매일 정해진 시간의 기록 알림 -->
        <receiver
            android:name=".ReminderReceiver"
            android:exported="false" />

        <!-- 빠른 설정창의 메모 버튼 -->
        <service
            android:name=".QuickTile"
            android:exported="true"
            android:icon="@drawable/ic_note"
            android:label="바로메모"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- 폰을 재부팅해도 알림창 입력칸 다시 띄우기 -->
        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- 홈 화면 위젯: 다섯 가지 모양 중에서 골라 놓는다 -->
        <receiver android:name=".NoteWidget" android:exported="true" android:label="바로메모 · 입력바">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/note_widget_info" />
        </receiver>
        <receiver android:name=".WidgetB" android:exported="true" android:label="바로메모 · 버튼 4개">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_b_info" />
        </receiver>
        <receiver android:name=".WidgetC" android:exported="true" android:label="바로메모 · 최근 메모">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_c_info" />
        </receiver>
        <receiver android:name=".WidgetD" android:exported="true" android:label="바로메모 · 기분 기록">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_d_info" />
        </receiver>
        <receiver android:name=".WidgetE" android:exported="true" android:label="바로메모 · 작은 버튼">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_e_info" />
        </receiver>

        <!-- "사진 복사"한 사진을 붙여넣는 앱에만 잠깐 읽게 해 준다 -->
        <provider
            android:name=".PhotoProvider"
            android:authorities="com.baromemo.app.photos"
            android:exported="false"
            android:grantUriPermissions="true" />

        <!-- 위젯의 기분 이모지를 누르면 바로 기록 -->
        <receiver android:name=".MoodReceiver" android:exported="false" />
    </application>
</manifest>
