<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="10dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp">

        <!-- 제목 + 설정 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="8dp">

            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginStart="2dp"
                android:contentDescription="바로메모 아이콘"
                android:scaleType="fitCenter"
                android:src="@mipmap/ic_launcher" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingStart="8dp"
                android:text="바로메모"
                android:textColor="@color/text"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/settings"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:clickable="true"
                android:contentDescription="설정"
                android:focusable="true"
                android:gravity="center"
                android:text="⚙"
                android:textColor="@color/sub"
                android:textSize="22sp" />
        </LinearLayout>

        <!-- 입력 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_input"
            android:gravity="center_vertical"
            android:minHeight="52dp"
            android:orientation="horizontal"
            android:paddingStart="18dp"
            android:paddingEnd="6dp">

            <EditText
                android:id="@+id/input"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@null"
                android:hint="떠오른 걸 바로 적으세요"
                android:imeOptions="actionDone"
                android:inputType="text"
                android:minHeight="48dp"
                android:textColor="@color/text"
                android:textColorHint="@color/sub"
                android:textSize="16sp" />

            <ImageView
                android:id="@+id/mic"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:clickable="true"
                android:contentDescription="받아쓰기"
                android:focusable="true"
                android:padding="9dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_w_mic"
                android:tint="@color/sub" />

            <TextView
                android:id="@+id/photo"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:clickable="true"
                android:contentDescription="사진·그림 붙이기"
                android:focusable="true"
                android:gravity="center"
                android:text="＋"
                android:textColor="@color/sub"
                android:textSize="24sp" />

            <TextView
                android:id="@+id/save"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="@drawable/bg_btn_accent"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:text="저장"
                android:textColor="?attr/bmOnAccent"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 기분 한 번에 기록: 누르면 그 기분이 바로 저장된다 (입력칸에 쓴 글이 있으면 같이) -->
        <LinearLayout
            android:id="@+id/mood_row"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="6dp"
            android:orientation="horizontal"
            android:visibility="gone">

            <ImageView
                android:id="@+id/mood1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:contentDescription="기분: 아주 좋음"
                android:focusable="true"
                android:padding="9dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_w_face1" />
            <ImageView
                android:id="@+id/mood2"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:contentDescription="기분: 좋음"
                android:focusable="true"
                android:padding="9dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_w_face2" />
            <ImageView
                android:id="@+id/mood3"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:contentDescription="기분: 보통"
                android:focusable="true"
                android:padding="9dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_w_face3" />
            <ImageView
                android:id="@+id/mood4"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:contentDescription="기분: 안 좋음"
                android:focusable="true"
                android:padding="9dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_w_face4" />
            <ImageView
                android:id="@+id/mood5"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:contentDescription="기분: 아주 안 좋음"
                android:focusable="true"
                android:padding="9dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_w_face5" />
        </LinearLayout>

        <!-- 입력칸에 바로 붙이는 태그 버튼 -->
        <HorizontalScrollView
            android:id="@+id/input_tag_scroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:scrollbars="none"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/input_tag_row"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <!-- 탭 -->
        <LinearLayout
            android:id="@+id/tab_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <TextView android:id="@+id/tab_list" style="@style/Tab" android:text="목록" />
            <TextView android:id="@+id/tab_calendar" style="@style/Tab" android:text="달력" />
            <TextView android:id="@+id/tab_summary" style="@style/Tab" android:text="요약" />
        </LinearLayout>

        <!-- 목록 탭: 검색 -->
        <EditText
            android:id="@+id/search"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_input"
            android:hint="🔍 메모 검색"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:textColor="@color/text"
            android:textColorHint="@color/sub"
            android:textSize="14sp" />

        <!-- 목록 탭: 태그로 모아 보기 -->
        <HorizontalScrollView
            android:id="@+id/tag_scroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:scrollbars="none"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/tag_row"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <!-- 달력 탭 -->
        <LinearLayout
            android:id="@+id/calendar_pane"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="10dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/cal_prev"
                    android:layout_width="48dp"
                    android:layout_height="40dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="‹"
                    android:textColor="@color/text"
                    android:textSize="24sp" />

                <TextView
                    android:id="@+id/cal_title"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:textColor="@color/text"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/cal_next"
                    android:layout_width="48dp"
                    android:layout_height="40dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="›"
                    android:textColor="@color/text"
                    android:textSize="24sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cal_weekdays"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />

            <LinearLayout
                android:id="@+id/cal_grid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>

        <!-- 달력 탭: 고른 날의 요약 -->
        <TextView
            android:id="@+id/day_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_card"
            android:lineSpacingExtra="4dp"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="16dp"
            android:paddingBottom="12dp"
            android:textColor="@color/text"
            android:textSize="14sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingTop="24dp"
            android:textColor="@color/sub"
            android:textSize="14sp"
            android:visibility="gone" />

        <ListView
            android:id="@+id/list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="10dp"
            android:layout_weight="1"
            android:divider="@android:color/transparent"
            android:dividerHeight="8dp"
            android:listSelector="@android:color/transparent"
            android:scrollbars="none" />

        <!-- 요약 탭 -->
        <ScrollView
            android:id="@+id/summary_pane"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="10dp"
            android:layout_weight="1"
            android:scrollbars="none"
            android:visibility="gone">

            <TextView
                android:id="@+id/summary_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:lineSpacingExtra="5dp"
                android:padding="18dp"
                android:textColor="@color/text"
                android:textIsSelectable="true"
                android:textSize="15sp" />
        </ScrollView>

        <!-- 여러 개 선택했을 때만 나오는 줄 -->
        <LinearLayout
            android:id="@+id/select_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_tab_selected"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView android:id="@+id/sel_count" style="@style/Flat" android:textColor="?attr/bmAccent" android:textStyle="bold" />
            <TextView android:id="@+id/sel_copy" style="@style/Flat" android:text="복사" android:textColor="@color/text" />
            <TextView android:id="@+id/sel_share" style="@style/Flat" android:text="내보내기" android:textColor="@color/text" />
            <TextView android:id="@+id/sel_delete" style="@style/Flat" android:text="삭제" android:textColor="@color/text" />
            <TextView android:id="@+id/sel_cancel" style="@style/Flat" android:text="취소" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
