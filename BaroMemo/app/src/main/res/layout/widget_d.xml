<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/w_input"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:background="@drawable/widget_chip"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:text="✏️  바로 메모하기"
        android:textColor="@color/sub"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="6dp">

        <TextView android:id="@+id/w_e1" android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:gravity="center" android:text="😊" android:textSize="24sp" />
        <TextView android:id="@+id/w_e2" android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:gravity="center" android:text="🙂" android:textSize="24sp" />
        <TextView android:id="@+id/w_e3" android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:gravity="center" android:text="😐" android:textSize="24sp" />
        <TextView android:id="@+id/w_e4" android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:gravity="center" android:text="😔" android:textSize="24sp" />
        <TextView android:id="@+id/w_e5" android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:gravity="center" android:text="😡" android:textSize="24sp" />
    </LinearLayout>
</LinearLayout>
