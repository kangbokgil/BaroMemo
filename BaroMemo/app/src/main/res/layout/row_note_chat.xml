<?xml version="1.0" encoding="utf-8"?>
<!-- 목록 모양 "말풍선": 나에게 보내는 메신저처럼 오른쪽 말풍선 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="end|bottom"
    android:orientation="horizontal"
    android:paddingStart="24dp">

    <TextView
        android:id="@+id/row_sticker"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="6dp"
        android:textSize="22sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/row_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="6dp"
        android:layout_marginBottom="2dp"
        android:textColor="@color/sub"
        android:textSize="11sp" />

    <LinearLayout
        android:id="@+id/row_body"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_bubble"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="10dp"
        android:paddingEnd="14dp"
        android:paddingBottom="10dp">

        <ImageView
            android:id="@+id/row_photo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:adjustViewBounds="true"
            android:background="@drawable/bg_photo"
            android:contentDescription="첨부 사진"
            android:maxWidth="220dp"
            android:maxHeight="300dp"
            android:scaleType="fitCenter"
            android:visibility="gone" />

        <TextView
            android:id="@+id/row_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="3dp"
            android:textColor="@color/text"
            android:textSize="16sp" />
    </LinearLayout>
</LinearLayout>
