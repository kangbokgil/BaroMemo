<?xml version="1.0" encoding="utf-8"?>
<!-- 상태 표시줄·알림 버튼용 단색 아이콘: 원근 종이 + 펜 + 잔상.
     단색이라 펜과 종이가 한 덩어리로 보이지 않도록, 펜이 지나가는 자리의 종이를 비워 두었다. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp" android:height="24dp"
    android:viewportWidth="24" android:viewportHeight="24">
    <!-- 잔상 -->
    <path android:pathData="M13,8.4L16.4,3.7" android:strokeColor="#FFFFFFFF" android:strokeAlpha="0.45"
        android:strokeWidth="2.8" android:strokeLineCap="round" />
    <!-- 종이: 펜 둘레를 따라 파낸 모양 -->
    <path android:pathData="M1.5,14.5L12,10L12.91,10.43L10.19,14.18L11.8,17.3L15.21,17.82L18.6,13.14L22.5,15L11,21.5Z"
        android:fillColor="#FFFFFFFF" />
    <!-- 펜 -->
    <path android:pathData="M13.4,15L20.9,4.7" android:strokeColor="#FFFFFFFF"
        android:strokeWidth="3" android:strokeLineCap="round" />
</vector>
